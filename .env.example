PORT=3000

# Base de donnees du service (recette) — demander l'URL a l'equipe, ne pas la commiter
SALLES_DB_URL=postgres://<utilisateur>:<mot-de-passe>@<hote>:5432/salles

# Signature des sessions
SESSION_SECRET=<generer avec: openssl rand -hex 16>

# Facturation — cle de test
STRIPE_SECRET_KEY=sk_test_<cle-de-test>
